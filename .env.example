# Template for the production secrets file. Copy it to the path your
# compose file's `env_file` points at (see docker-compose.example.yml)
# and fill in every value.
#
# Quoting matters. Compose strips double quotes but keeps single quotes
# verbatim, so wrap any value in single quotes to get it through unchanged.

# Session signing key. openssl rand -base64 32
# Changing it logs every user out once; no data loss.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=https://your-host.example.com

# Encrypts stored Google/SMTP/IMAP credentials. openssl rand -base64 32
# Used as a raw string (SHA-256'd in src/lib/crypto.ts), so a stray quote or
# space yields a different key and every stored connection stops decrypting.
ENCRYPTION_KEY=

# Google OAuth (Drive, Calendar, Gmail)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# LLM providers (OpenAI-compatible)
OPENCODE_API_KEY=
OPENROUTER_API_KEY=
